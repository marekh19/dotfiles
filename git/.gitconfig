[user]
  name = Marek Honzal
  email = hi@marekhonzal.com
  signingkey = ~/.ssh/id_github.pub

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true

[include]
  path = ~/.config/git/meowsoot.gitconfig

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true  # use n and N to move between diff sections

[merge]
  conflictStyle = zdiff3
