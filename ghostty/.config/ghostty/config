# Colorscheme
theme = meowsoot

# Fonts
font-size = 14
font-family = "JetBrains Mono"
font-thicken = true

# Fallback font for icons
font-family = Symbols Nerd Font Mono

adjust-cell-height = 20%

# Window
macos-titlebar-style = hidden

window-padding-x = 4
window-padding-y = 2

shell-integration = fish

# Cursor
custom-shader = shaders/cursor_warp.glsl
